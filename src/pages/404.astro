---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found">
  <PageHero label="404" title="Take a breath." accent="This page has moved on.">
    <p>The page you're looking for isn't here, but plenty else is.</p>
    <div class="btn-row" style="justify-content:center;margin-top:2rem">
      <a class="btn" href="/">Back home</a>
      <a class="btn btn--line" href="/services">View services</a>
    </div>
  </PageHero>
</Base>
