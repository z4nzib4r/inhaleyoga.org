---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { serviceGroups } from '../data/content';
import hero from '../assets/images/acupuncture-closeup.jpg';

const steps = [
  { t: 'Start with a free call', d: "A 15–20 minute phone consult to see if we're a good fit and plan your first visits." },
  { t: 'Book your initial visit', d: 'New acupuncture patients begin with a 90-minute visit to build a treatment plan.' },
  { t: 'HSA & FSA welcome', d: "We don't bill insurance, but we'll give you a receipt to submit for reimbursement." },
];
---

<Base
  title="Services & Pricing"
  description="Acupuncture, orthopedic acupuncture, Thai Bliss massage, cupping, reflexology and wellness coaching in Athens, Ohio, with durations and prices."
>
  <PageHero label="Services & pricing" title="A menu" accent="of care" image={hero} imageAlt="Acupuncture needles being placed in a patient's back" position="40% 50%">
    <p>
      Whether it's precise clinical work on a stubborn injury or a slow, restorative session, every treatment is
      paced with care and priced plainly.
    </p>
  </PageHero>

  <nav class="jump" aria-label="Service categories">
    <div class="wrap jump__inner">
      {serviceGroups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
    </div>
  </nav>

  <section class="section steps-sec">
    <ol class="wrap steps">
      {
        steps.map((s, i) => (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <span class="steps__n">{i + 1}</span>
            <h2 class="t-3">{s.t}</h2>
            <p>{s.d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    serviceGroups.map((group, gi) => (
      <section id={group.id} class:list={['section group', { 'bg-2': gi % 2 === 0 }]}>
        <div class="wrap group__grid">
          <header class="group__head">
            <span class="label reveal">{String(gi + 1).padStart(2, '0')} / {String(serviceGroups.length).padStart(2, '0')}</span>
            <h2 class="t-1 reveal">{group.title}</h2>
            <p class="muted reveal">{group.intro}</p>
            <div class="group__img arch reveal">
              <Image src={group.services[0].image} alt="" widths={[360, 600]} sizes="(min-width: 960px) 24vw, 0px" />
            </div>
          </header>

          <ul class="list">
            {group.services.map((s) => (
              <li class="item reveal">
                <div class="item__top">
                  <h3 class="item__name">
                    {s.name}
                    {s.note && <span class="item__badge">{s.note}</span>}
                  </h3>
                  <span class="item__leader" aria-hidden="true" />
                  <span class="item__price">${s.price}</span>
                </div>
                <p class="item__desc">{s.summary}</p>
                <div class="item__foot">
                  <span class="item__dur">{s.duration}</span>
                  <a class="item__link" href={`/contact?service=${encodeURIComponent(s.name)}#form`}>
                    Request <span class="sr-only">{s.name}</span> →
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <CtaBand />
</Base>

<style>
  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: rgb(251 247 242 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-block: 1px solid var(--line);
  }
  .jump__inner {
    display: flex;
    gap: 0.4rem;
    padding-block: 0.7rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .jump a {
    flex: none;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.25s;
  }
  .jump a:hover {
    background: var(--peach-1);
  }

  .steps-sec {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .steps {
    display: grid;
    gap: 2.5rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 820px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
  .steps__n {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: var(--peach-2);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
  }
  .steps h2 {
    margin-bottom: 0.4rem;
  }
  .steps p {
    margin: 0;
    color: var(--ink-2);
  }

  .group {
    scroll-margin-top: calc(var(--header-h) + 56px);
  }
  .group__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 960px) {
    .group__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 6rem;
      align-items: start;
    }
    .group__head {
      position: sticky;
      top: calc(var(--header-h) + 5rem);
    }
  }
  .group__img {
    width: min(100%, 300px);
    aspect-ratio: 4 / 5;
    margin-top: 2rem;
  }
  @media (max-width: 959px) {
    .group__img {
      display: none;
    }
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-2);
  }
  .item {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line-2);
  }
  .item__top {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .item__name {
    margin: 0;
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    line-height: 1.2;
  }
  .item__badge {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--teal);
    color: var(--white);
    font-family: var(--sans);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    vertical-align: 0.35em;
  }
  .item__leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted var(--stone);
    translate: 0 -0.3em;
    opacity: 0.6;
  }
  .item__price {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-variation-settings: 'SOFT' 100;
    color: var(--rose);
  }
  .item__desc {
    max-width: 52ch;
    margin: 0.5rem 0 0.9rem;
    color: var(--ink-2);
  }
  .item__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .item__dur {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .item__link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
</style>
